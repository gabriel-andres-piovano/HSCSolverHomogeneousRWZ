Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalA]", "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "r"}], ")"}], 
      RowBox[{"(", 
