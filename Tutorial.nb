        RowBox[{"-", "2"}], "+", "r"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "r", "+", 
        RowBox[{"I", " ", 
         RowBox[{"r", "^", "2"}], "\[Omega]"}]}], ")"}]}], 
     RowBox[{
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", "\[Lambda]"}], ")"}]}], "-", 
      RowBox[{"12", " ", "I", " ", "\[Omega]"}]}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[ScriptCapitalA]", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "12"}], "+", 
     RowBox[{
      RowBox[{"r", "^", "2"}], " ", 
      RowBox[{"(", 
