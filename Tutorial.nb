Cell[BoxData[
 RowBox[{
  RowBox[{"mapTtoRWUp", "[", 
   RowBox[{"r0_", ",", "l_", ",", "m_", ",", "\[Omega]_", ",", "r2g_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"M", "=", "1"}], ",", 
      RowBox[{"a", "=", "0"}], ",", 
      RowBox[{"s", "=", 
       RowBox[{"-", "2"}]}], ",", "\[Lambda]", ",", "\[CapitalDelta]", ",", 
      "Rup", ",", "dRup", ",", "\[Mu]sqr", ",", "\[Kappa]", ",", "Q", ",", 
      "W", ",", "RWup", ",", "dRWup", ",", "p1", ",", "q1", ",", 
      "\[ScriptCapitalA]", ",", "\[ScriptCapitalB]", ",", 
      "d\[ScriptCapitalA]", ",", "d\[ScriptCapitalB]", ",", 
      "\[ScriptCapitalD]trans"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Lambda]", "=", 
      RowBox[{
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}], "-", 
       RowBox[{"s", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "s"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalDelta]", "=", 
      RowBox[{"r0", 
       RowBox[{"(", 
        RowBox[{"r0", "-", 
         RowBox[{"2", " ", "M"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Rup", ",", "dRup"}], "}"}], "=", 
      RowBox[{
       RowBox[{"TsolverUp", "[", 
        RowBox[{
        "s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", "\[Lambda]", 
         ",", "r2g"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[ScriptCapitalA]", "=", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", "r0"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "6"}], "+", 
           RowBox[{"r0", 
            RowBox[{"(", 
             RowBox[{"2", "+", "\[Lambda]"}], " ", ")"}]}]}], ")"}]}], "+", 
        RowBox[{"2", " ", "I", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "3"}], "+", "r0"}], ")"}], " ", 
         RowBox[{"r0", "^", "2"}], " ", "\[Omega]"}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"r0", "^", "4"}], " ", 
         RowBox[{"\[Omega]", "^", "2"}]}]}], 
       RowBox[{"r0", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", "\[Lambda]"}], ")"}]}], "-", 
          RowBox[{"12", " ", "I", " ", "\[Omega]"}]}], ")"}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[ScriptCapitalB]", "=", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "r0"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "+", "r0", "+", 
          RowBox[{"I", " ", 
           RowBox[{"r0", "^", "2"}], "\[Omega]"}]}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Lambda]", " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "\[Lambda]"}], ")"}]}], "-", 
        RowBox[{"12", " ", "I", " ", "\[Omega]"}]}]]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"d\[ScriptCapitalA]", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "12"}], "+", 
        RowBox[{
         RowBox[{"r0", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "\[Lambda]", " ", "-", 
           RowBox[{"2", " ", "\[Omega]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", "I"}], "+", 
              RowBox[{"r0", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "2"}], " ", "I"}], "+", 
                 RowBox[{"3", " ", "r0", " ", "\[Omega]"}]}], ")"}]}]}], 
             ")"}]}]}], ")"}]}]}], 
       RowBox[{
        RowBox[{"r0", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", "\[Lambda]"}], ")"}]}], "-", 
          RowBox[{"12", " ", "I", " ", "\[Omega]"}]}], ")"}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d\[ScriptCapitalB]", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "10"}], "+", 
        RowBox[{"4", " ", "r0"}], "+", 
        RowBox[{"2", " ", "I", " ", "r0", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "4"}], "+", 
           RowBox[{"3", " ", "r0"}]}], ")"}], " ", "\[Omega]"}]}], 
       RowBox[{
        RowBox[{"\[Lambda]", " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "\[Lambda]"}], ")"}]}], "-", 
        RowBox[{"12", " ", "I", " ", "\[Omega]"}]}]]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"p1", "=", 
      FractionBox["2", "\[CapitalDelta]"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q1", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "r0"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "6"}], "+", 
             RowBox[{"r0", " ", 
              RowBox[{"(", 
               RowBox[{"2", "+", "\[Lambda]"}], ")"}]}]}], ")"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"r0", "^", "4"}], " ", 
         RowBox[{"\[Omega]", "^", "2"}]}]}], 
       RowBox[{"\[CapitalDelta]", "^", "2"}]]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"\[ScriptCapitalD]trans", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"4", " ", 
         RowBox[{"\[Omega]", "^", "2"}]}], 
        RowBox[{
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"(", 
           RowBox[{"2", "+", "\[Lambda]"}], ")"}]}], "-", 
         RowBox[{"12", " ", "I", " ", "\[Omega]"}]}]]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"RWup", "=", 
      RowBox[{"\[ScriptCapitalD]trans", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"dRup", "[", "r0", "]"}], " ", "\[ScriptCapitalB]"}], 
           RowBox[{
            RowBox[{"\[ScriptCapitalA]", " ", 
             RowBox[{"(", 
              RowBox[{"d\[ScriptCapitalB]", "+", "\[ScriptCapitalA]"}], 
              ")"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"d\[ScriptCapitalA]", "+", 
               RowBox[{"p1", " ", "\[ScriptCapitalA]"}]}], ")"}], " ", 
             "\[ScriptCapitalB]"}], "+", 
            RowBox[{"q1", " ", 
             RowBox[{"\[ScriptCapitalB]", "^", "2"}]}]}]]}], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"Rup", "[", "r0", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"d\[ScriptCapitalB]", "+", "\[ScriptCapitalA]", "-", 
             RowBox[{"p1", " ", "\[ScriptCapitalB]"}]}], ")"}]}], 
          RowBox[{
           RowBox[{"\[ScriptCapitalA]", " ", 
            RowBox[{"(", 
             RowBox[{"d\[ScriptCapitalB]", "+", "\[ScriptCapitalA]"}], 
             ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d\[ScriptCapitalA]", "+", 
              RowBox[{"p1", " ", "\[ScriptCapitalA]"}]}], ")"}], " ", 
            "\[ScriptCapitalB]"}], "+", 
           RowBox[{"q1", " ", 
            RowBox[{"\[ScriptCapitalB]", "^", "2"}]}]}]]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dRWup", "=", 
      RowBox[{"\[ScriptCapitalD]trans", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"dRup", "[", "r0", "]"}], " ", "\[ScriptCapitalA]"}], 
          RowBox[{
           RowBox[{"\[ScriptCapitalA]", " ", 
            RowBox[{"(", 
             RowBox[{"d\[ScriptCapitalB]", "+", "\[ScriptCapitalA]"}], 
             ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d\[ScriptCapitalA]", "+", 
              RowBox[{"p1", " ", "\[ScriptCapitalA]"}]}], ")"}], " ", 
            "\[ScriptCapitalB]"}], "+", 
           RowBox[{"q1", " ", 
            RowBox[{"\[ScriptCapitalB]", "^", "2"}]}]}]], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"Rup", "[", "r0", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "d\[ScriptCapitalA]"}], "+", 
             RowBox[{"q1", " ", "\[ScriptCapitalB]"}]}], ")"}]}], 
          RowBox[{
           RowBox[{"\[ScriptCapitalA]", " ", 
            RowBox[{"(", 
             RowBox[{"d\[ScriptCapitalB]", "+", "\[ScriptCapitalA]"}], 
             ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d\[ScriptCapitalA]", "+", 
              RowBox[{"p1", " ", "\[ScriptCapitalA]"}]}], ")"}], " ", 
            "\[ScriptCapitalB]"}], "+", 
           RowBox[{"q1", " ", 
            RowBox[{"\[ScriptCapitalB]", "^", "2"}]}]}]]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"RWup", ",", "dRWup"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
