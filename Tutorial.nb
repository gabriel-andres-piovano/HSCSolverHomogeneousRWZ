Cell[CellGroupData[{

Cell["\<\
From solutions Teukolsky equation to solutions Regge-Wheeler equation\
\>", "Subsection",
 CellChangeTimes->{{3.808807344279475*^9, 3.8088073650859833`*^9}, {
   3.8125315802490253`*^9, 3.8125315891465187`*^9}, {3.831206409559864*^9, 
   3.83120643293403*^9}, {3.984843909789753*^9, 3.984843948468543*^9}, 
   3.9863964404759817`*^9, 
   3.986397874333787*^9},ExpressionUUID->"f77c9457-d0bf-42a7-9422-\
15d520f2dfe6"],

Cell["\<\
This section uses the package HSCSolverHomogeneousRadialTeukolsky, available \
here https://github.com/gabriel-andres-piovano/\
HSCSolverHomogeneousRadialTeukolsky, to calculate the solutions of the \
homogeneous radial Teukolsky equation. These solutions are then mapped to the \
solutions of the homogeneous Regge-Wheeler equation via the Chandrasekhar \
transformation (which are an example of the more general Darboux \
transformations).\
\>", "Text",
 CellChangeTimes->{{3.9876482100319967`*^9, 3.9876483573486*^9}, {
   3.987648409418927*^9, 3.987648465334832*^9}, 
   3.987648627332622*^9},ExpressionUUID->"89ba3a8d-23f8-495d-ae13-\
a8ba2a6bf574"],

Cell["\<\
The file \[OpenCurlyDoubleQuote]HSCSolverHomogeneousRadialTeukolsky.wl\
\[CloseCurlyDoubleQuote] must be placed at one of the paths shown in the \
variables $BaseDirectory (for system-wide installations) and \
$UserBaseDirectory (for single-user installations).  You need to place it in \
the Applications/ subdirectory (or subfolder) of those returned by those \
variables. 

Alternatively, you can load package using the command\
\>", "Text",
 CellChangeTimes->{{3.986027715574061*^9, 3.98602772784727*^9}, 
   3.9861407722130127`*^9, {3.986140805929224*^9, 3.986140886080261*^9}, {
   3.986188741165391*^9, 3.986188752656083*^9}, {3.986197072836914*^9, 
   3.986197074677515*^9}},ExpressionUUID->"63a58fcf-bedb-41b3-8b89-\
658a73752bda"],

